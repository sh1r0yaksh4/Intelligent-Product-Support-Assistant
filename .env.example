# xAI Grok API Configuration (Required)
GROK_API_KEY=your_xai_grok_api_key_here
GROK_API_BASE=https://api.x.ai/v1

# Grok Model Selection
GROK_GENERATION_MODEL=grok-2-latest
GROK_SEARCH_MODEL=grok-2-latest
GROK_VISION_MODEL=grok-2-vision-1212

# RAG & Retrieval Thresholds
MIN_DOCUMENT_SIMILARITY=0.42
EMBEDDING_DIMENSIONS=768
CHROMA_PERSIST_DIRECTORY=data/chroma_store
CHROMA_COLLECTION_NAME=product_documents
RETRIEVAL_TOP_K=5
